MasterPc input, #tblMasterPc select { font: inherit; font-size: 12.5px; padding: 3px 6px; border: 1px solid var(--line); border-radius: 6px; background: var(--surface); color: var(--ink); }\n.grid tr.dim td { opacity: .5; }\n.gate-form { display: flex; flex-direction: column; gap: 8px; max-width: 360px; margin-top: 10px; }\n.gate-form input { font: inherit; font-size: 14px; padding: 8px 10px; border: 1px solid var(--line); border-radius: 8px; background: var(--surface); color: var(--ink); }\n.gate-form .btn { padding: 8px 14px; }\n.link-btn { font: inherit; font-size: 12.5px; background: none; border: 0; color: var(--accent); cursor: pointer; padding: 0 2px; text-decoration: underline; }\ntd.nowrap { white-space: nowrap; }\n#tblMembers input[type=email] { min-width: 190px; }\n.connect-help { color: var(--ink); background: var(--warn-soft); border-radius: 8px; padding: 10px 12px; font-size: 13px; margin-top: 8px; max-width: 720px; }\n.connect-help ol { margin: 6px 0; padding-left: 20px; }\n.connect-help a { word-break: break-all; }\n.connect-help code { font-family: var(--mono); font-size: 12px; }\n\n/* ================================================================ app shell (v2 layout) */\n.top { margin-bottom: 0; position: sticky; top: 0; z-index: 30; }\n.top-inner { padding: 10px 20px; }\n.brand { display: flex; align-items: center; gap: 12px; }\n.logo { display: inline-grid; place-items: center; width: 36px; height: 36px; border-radius: 9px; background: var(--accent); color: var(--accent-ink); font-weight: 600; font-size: 14px; letter-spacing: .5px; }\n.brand h1 { font-size: 17px; line-height: 1.2; }\n.brand .sub { margin: 0; font-size: 12px; }\n\n.shell { display: grid; grid-template-columns: 232px minmax(0, 1fr); min-height: calc(100vh - 58px); }\n.shell:has(> .sidenav[hidden]) { grid-template-columns: minmax(0, 1fr); }\n.sidenav { position: sticky; top: 58px; align-self: start; height: calc(100vh - 58px); overflow-y: auto;\n  background: var(--surface); border-right: 1px solid var(--line); padding: 14px 10px; display: flex; flex-direction: column; gap: 2px; }\n.nav-group { font-size: 11.5px; color: var(--ink-2); text-transform: uppercase; letter-spacing: .4px; padding: 12px 10px 4px; }\n.nav-group:first-child { padding-top: 0; }\n.nav-item { font: inherit; font-size: 14px; display: flex; align-items: center; gap: 10px; width: 100%; text-align: left;\n  background: none; border: 0; border-radius: 8px; padding: 9px 10px; color: var(--ink-2); cursor: pointer; border-bottom: 0; }\n.nav-item svg { width: 18px; height: 18px; flex: none; fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }\n.nav-item span:not(.badge) { flex: 1; }\n.nav-item:hover { background: var(--surface-2); color: var(--ink); }\n.nav-item.active { background: var(--accent-soft); color: var(--accent); font-weight: 600; }\n.badge.alert { background: var(--bad); color: #fff; }\n\n.main { padding: 20px 24px 40px; min-width: 0; max-width: 1400px; }\n.main > #gate { max-width: 560px; margin: 40px auto; }\n.page-head { display: flex; justify-content: space-between; align-items: flex-end; gap: 12px; flex-wrap: wrap; margin-bottom: 14px; }\n.page-head h2 { font-size: 20px; }\n.panel h3 { font-size: 15px; margin: 0 0 10px; font-weight: 600; display: flex; align-items: center; gap: 8px; }\n.btn.lg { padding: 10px 16px; font-size: 14px; font-weight: 600; }\n\n/* home */\n.home-grid { display: grid; grid-template-columns: minmax(0, 3fr) minmax(0, 2fr); gap: 16px; }\n.steps { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 10px; }\n.steps li { display: flex; align-items: center; gap: 12px; padding: 10px 12px; border: 1px solid var(--line); border-radius: 10px; }\n.steps li.done { background: var(--good-soft); border-color: transparent; }\n.step-no { display: inline-grid; place-items: center; flex: none; width: 28px; height: 28px; border-radius: 50%; background: var(--accent); color: var(--accent-ink); font-weight: 600; font-size: 13px; }\n.steps li.done .step-no { background: var(--good); color: #fff; }\n.step-body { flex: 1; min-width: 0; }\n.step-status { font-size: 12.5px; margin-top: 2px; font-family: var(--mono); }\n.alert-row { display: flex; align-items: center; justify-content: space-between; gap: 12px; background: var(--warn-soft); color: var(--ink);\n  border-radius: 10px; padding: 10px 14px; margin-bottom: 10px; font-size: 13.5px; }\n.todo-list { list-style: none; margin: 0 0 8px; padding: 0; }\n.todo-list li { display: flex; align-items: center; gap: 10px; padding: 8px 6px; border-bottom: 1px solid var(--line); cursor: pointer; font-size: 13px; }\n.todo-list li:hover { background: var(--surface-2); }\n.todo-main { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }\n.empty-sm { color: var(--ink-2); padding: 18px 0; text-align: center; }\n\n/* step 1: pick items */\n.switch { display: inline-flex; align-items: center; gap: 8px; font-size: 13px; color: var(--ink-2); cursor: pointer; }\n.switch input { width: 16px; height: 16px; accent-color: var(--accent); }\nbody:not(.detail-mode) .detail-only { display: none; }\n.item-name { font-weight: 500; }\n.src-tag { font-size: 11px; color: var(--ink-2); }\n#tblCompare td.flags { color: var(--warn); max-width: 240px; }\n\n/* step 2: review & send */\n.stepper { list-style: none; display: flex; gap: 0; padding: 0; margin: 0 0 14px; counter-reset: s; }\n.stepper li { counter-increment: s; flex: 1; text-align: center; font-size: 13px; color: var(--ink-2); padding: 8px 6px; border-bottom: 3px solid var(--line); }\n.stepper li::before { content: counter(s) '. '; font-weight: 600; }\n.stepper li.on { color: var(--accent); border-bottom-color: var(--accent); font-weight: 600; }\n.submit-box { margin-top: 16px; border-top: 0; padding-top: 16px; }\n\n/* sticky basket */\n.cart-bar { position: fixed; left: 0; right: 0; bottom: 0; z-index: 40; background: var(--surface); border-top: 1px solid var(--line);\n  box-shadow: 0 -6px 20px rgba(0, 0, 0, .08); }\n.cart-bar-inner { max-width: 1400px; margin: 0 auto; padding: 10px 24px 10px 256px; display: flex; align-items: center; justify-content: space-between; gap: 12px; }\nbody.has-cartbar .main { padding-bottom: 90px; }\n\n/* mobile: nav becomes a scrollable strip under the header */\n@media (max-width: 860px) {\n  .shell { grid-template-columns: minmax(0, 1fr); }\n  .sidenav { position: sticky; top: 56px; height: auto; flex-direction: row; overflow-x: auto; border-right: 0; border-bottom: 1px solid var(--line);\n    padding: 6px 8px; z-index: 20; }\n  .nav-group { display: none; }\n  .nav-item { width: auto; white-space: nowrap; padding: 7px 10px; font-size: 13px; }\n  .main { padding: 14px 16px 40px; }\n  .home-grid { grid-template-columns: 1fr; }\n  .cart-bar-inner { padding: 10px 16px; }\n  .brand .sub { display: none; }\n}\n.stepper li.done { color: var(--good); border-bottom-color: var(--good); }\n.stepper li.done::before { content: '✓ '; }\n\n/* ================================================================ budget page */\n#budgetCards { margin-bottom: 16px; }\n.card .v.over, td.over, .num.over, .use-pct.over { color: var(--bad); }\ntd.ok, .num.ok { color: var(--good); }\n.month-chart { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); gap: 6px; align-items: end; }\n.mc { font: inherit; background: none; border: 1px solid transparent; border-radius: 8px; padding: 6px 2px; cursor: pointer; display: flex; flex-direction: column; align-items: center; gap: 4px; color: var(--ink); }\n.mc:hover, .mc.sel { background: var(--accent-soft); border-color: var(--accent); }\n.mc-bars { position: relative; width: 70%; max-width: 38px; height: 110px; }\n.mc-bars i { position: absolute; left: 0; right: 0; bottom: 0; border-radius: 3px 3px 0 0; }\n.mc-bars i.p { background: var(--line); }\n.mc-bars i.u { background: var(--accent); left: 18%; right: 18%; }\n.mc-bars i.r { background: color-mix(in srgb, var(--accent) 35%, transparent); left: 18%; right: 18%; }\n.mc.over .mc-bars i.u { background: var(--bad); }\n.mc-label { font-size: 12px; color: var(--ink-2); }\n.mc-left { font-size: 11px; font-family: var(--mono); color: var(--good); }\n.mc-left.over { color: var(--bad); }\n.use-bar { display: inline-block; vertical-align: middle; width: 110px; height: 8px; border-radius: 4px; background: var(--surface-2); overflow: hidden; position: relative; }\n.use-bar i { position: absolute; top: 0; bottom: 0; }\n.use-bar i.a { left: 0; background: var(--accent); }\n.use-bar i.c { background: color-mix(in srgb, var(--accent) 35%, transparent); }\n.use-bar.over i.a { background: var(--bad); }\n.use-pct { font-family: var(--mono); font-size: 12px; margin-left: 6px; }\n.bar-cell { white-space: nowrap; }\ntr.brow { cursor: pointer; }\n.caret { color: var(--ink-2); display: inline-block; width: 12px; }\ntr.bdetail > td { background: var(--surface-2); padding: 10px 12px 14px; }\n.month-table { background: var(--surface); border: 1px solid var(--line); border-radius: 8px; }\n.month-table tr.now td { background: var(--accent-soft); }\n#tblBudget tfoot th { position: sticky; bottom: 0; background: var(--surface-2); border-top: 1px solid var(--line); font-size: 13px; color: var(--ink); }\n@media (max-width: 860px) { .month-chart { grid-template-columns: repeat(6, minmax(0, 1fr)); } .use-bar { width: 70px; } }\n\n/* per-item budget in the cart + grouped summary with Over Budget */\n.bcell { white-space: nowrap; }\n.bcell select { font: inherit; font-size: 12px; padding: 2px 4px; border: 1px solid var(--line); border-radius: 6px; background: var(--surface); color: var(--ink); }\n.bcell .bsel { max-width: 240px; margin-right: 4px; }\n.bline { border: 1px solid var(--line); border-radius: 8px; padding: 8px 10px; margin-bottom: 8px; background: var(--surface); }\n.bline.warn { display: flex; justify-content: space-between; gap: 8px; border-color: var(--bad); color: var(--bad); }\n.bline.is-over { border-color: var(--bad); background: var(--bad-soft); }\n.bline-head { display: flex; flex-direction: column; margin-bottom: 4px; }\n.over-req { display: flex; align-items: center; gap: 6px; margin-top: 6px; font-weight: 600; color: var(--bad); cursor: pointer; }\n.over-reason { width: 100%; margin-top: 4px; font: inherit; font-size: 13px; padding: 5px 8px; border: 1px solid var(--bad); border-radius: 8px; background: var(--surface); color: var(--ink); }\n.req-budget { list-style: none; margin: 6px 0; padding: 0; font-size: 13px; }\n.req-budget li { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 4px 12px; padding: 4px 8px; border-left: 3px solid var(--line); margin-bottom: 3px; }\n.req-budget li.is-over { border-left-color: var(--bad); background: var(--bad-soft); }\n.req-budget li .over { flex-basis: 100%; }\ntd.small { font-size: 12px; max-width: 280px; }\n\n/* approval / purchasing email composer */\n.composer { margin-top: 10px; padding: 12px; border: 1px solid var(--line); border-radius: var(--radius); background: var(--surface-2); }\n.composer h4 { margin: 0 0 8px; }\n.compose-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 8px 12px; }\n.compose-grid label { display: flex; flex-direction: column; gap: 3px; font-size: 12.5px; color: var(--ink-2); }\n.compose-grid .wide { grid-column: 1 / -1; }\n.compose-grid input, .compose-grid textarea { font: inherit; font-size: 13px; padding: 5px 8px; border: 1px solid var(--line); border-radius: 8px; background: var(--surface); color: var(--ink); }\n.mail-preview { width: 100%; height: 460px; margin-top: 8px; border: 1px solid var(--line); border-radius: 8px; background: #fff; }\n</style>\n\n  <script src=\"https://cdn.jsdelivr.net/npm/xlsx@0.18.5/dist/xlsx.full.min.js\"></script>\n</head>\n<body>\n  <header class=\"top\">\n    <div class=\"top-inner\">\n      <div class=\"brand\">\n        <span class=\"logo\" aria-hidden=\"true\">SR</span>\n        <div>\n          <h1>Store Reorder AI</h1>\n          <p class=\"sub\">PG44 Static Media · ระบบสั่งซื้อของ Store</p>\n        </div>\n      </div>\n      <div class=\"top-actions\">\n        <span id=\"whoami\" class=\"who\" hidden></span>\n      </div>\n    </div>\n  </header>\n\n  <div class=\"shell\">\n    <!-- Navigation: one item per job; buttons keep class \"tab\" so app.js switches views -->\n    <nav id=\"sidenav\" class=\"sidenav\" aria-label=\"เมนู\">\n      <div class=\"nav-group\">งานหลัก</div>\n      <button class=\"tab nav-item active\" data-tab=\"home\"><svg viewBox=\"0 0 24 24\"><path d=\"M3 11l9-7 9 7v9a1 1 0 0 1-1 1h-5v-6H9v6H4a1 1 0 0 1-1-1z\"/></svg><span>หน้าแรก</span></button>\n      <button class=\"tab nav-item\" data-tab=\"compare\"><svg viewBox=\"0 0 24 24\"><path d=\"M4 5h16M4 12h16M4 19h10\"/><path d=\"M17 17l2 2 3-4\"/></svg><span>1. เลือกรายการสั่ง</span></button>\n      <button class=\"tab nav-item\" data-tab=\"cart\"><svg viewBox=\"0 0 24 24\"><path d=\"M3 4h2l2 11h11l2-8H6\"/><circle cx=\"9\" cy=\"19\" r=\"1.5\"/><circle cx=\"17\" cy=\"19\" r=\"1.5\"/></svg><span>2. ตรวจ &amp; ส่งคำขอ</span><span id=\"cartBadge\" class=\"badge\">0</span></button>\n      <button class=\"tab nav-item\" data-tab=\"requests\" id=\"tabRequests\" hidden><svg viewBox=\"0 0 24 24\"><path d=\"M4 4h16v12H7l-3 3z\"/><path d=\"M8 9h8M8 12h5\"/></svg><span>3. ติดตามคำขอ</span><span id=\"reqBadge\" class=\"badge alert\" hidden>0</span></button>\n      <div class=\"nav-group\">ข้อมูล</div>\n      <button class=\"tab nav-item\" data-tab=\"budget\" id=\"tabBudget\" hidden><svg viewBox=\"0 0 24 24\"><rect x=\"3\" y=\"6\" width=\"18\" height=\"13\" rx=\"2\"/><path d=\"M3 10h18M7 15h4\"/></svg><span>งบประมาณ</span></button>\n      <button class=\"tab nav-item\" data-tab=\"data\"><svg viewBox=\"0 0 24 24\"><path d=\"M4 6c0-1.7 3.6-3 8-3s8 1.3 8 3-3.6 3-8 3-8-1.3-8-3z\"/><path d=\"M4 6v12c0 1.7 3.6 3 8 3s8-1.3 8-3V6M4 12c0 1.7 3.6 3 8 3s8-1.3 8-3\"/></svg><span>ข้อมูล Store</span></button>\n      <button class=\"tab nav-item\" data-tab=\"merged\"><svg viewBox=\"0 0 24 24\"><rect x=\"3\" y=\"4\" width=\"18\" height=\"16\" rx=\"1\"/><path d=\"M3 10h18M9 4v16\"/></svg><span>ตารางรวมทั้งหมด</span></button>\n      <button class=\"tab nav-item\" data-tab=\"ai\"><svg viewBox=\"0 0 24 24\"><path d=\"M12 3l1.8 4.7L18.5 9.5 13.8 11.3 12 16l-1.8-4.7L5.5 9.5l4.7-1.8z\"/><path d=\"M18 15l.8 2.2L21 18l-2.2.8L18 21l-.8-2.2L15 18l2.2-.8z\"/></svg><span>ผู้ช่วย AI</span></button>\n      <button class=\"tab nav-item\" data-tab=\"admin\" id=\"tabAdmin\" hidden><svg viewBox=\"0 0 24 24\"><circle cx=\"12\" cy=\"12\" r=\"3\"/><path d=\"M12 2v3M12 19v3M4.2 4.2l2.1 2.1M17.7 17.7l2.1 2.1M2 12h3M19 12h3M4.2 19.8l2.1-2.1M17.7 6.3l2.1-2.1\"/></svg><span>ตั้งค่าระบบ</span></button>\n    </nav>\n\n    <main class=\"main\">\n      <!-- Sign-in / sign-up (server mode) -->\n      <section id=\"gate\" class=\"panel\" hidden></section>\n\n      <div id=\"work\">\n        <!-- ============ Home ============ -->\n        <div id=\"tab-home\" class=\"tabpane\">\n          <div class=\"page-head\">\n            <div>\n              <h2 id=\"homeTitle\">หน้าแรก</h2>\n              <p id=\"homeSub\" class=\"hint\"></p>\n            </div>\n          </div>\n          <div id=\"homeAlerts\"></div>\n          <div class=\"home-grid\">\n            <section class=\"panel\">\n              <h3>ขั้นตอนการใช้งาน</h3>\n              <ol id=\"homeSteps\" class=\"steps\"></ol>\n            </section>\n            <section class=\"panel\">\n              <h3>งานที่รอคุณ <span id=\"homeTodoCount\" class=\"badge alert\" hidden>0</span></h3>\n              <div id=\"homeTodo\"></div>\n            </section>\n          </div>\n          <section id=\"summary\" class=\"panel\" hidden>\n            <h3>ภาพรวมสต๊อก</h3>\n            <div id=\"cards\" class=\"cards\"></div>\n          </section>\n        </div>\n\n        <!-- ============ Budget ============ -->\n        <div id=\"tab-budget\" class=\"tabpane\" hidden>\n          <div class=\"page-head\">\n            <div><h2>งบประมาณ</h2><p id=\"budgetSub\" class=\"hint\"></p></div>\n            <div class=\"panel-actions\">\n              <button id=\"btnBudgetExport\" class=\"btn sm ghost\">ส่งออก .xlsx</button>\n              <button id=\"btnBudgetReload\" class=\"btn sm ghost\">โหลดใหม่</button>\n            </div>\n          </div>\n          <div id=\"budgetEmpty\"></div>\n          <div id=\"budgetBody\">\n            <div id=\"budgetCards\" class=\"cards\"></div>\n            <section class=\"panel\">\n              <h3>ภาพรวมรายเดือน <span class=\"hint\" style=\"font-weight:400\">แท่งเทา = งบ · สีเข้ม = ใช้จริง · สีอ่อน = คำขอที่อนุมัติ/รออนุมัติ</span></h3>\n              <div id=\"budgetMonths\" class=\"month-chart\"></div>\n            </section>\n            <div class=\"home-grid\">\n              <section class=\"panel\"><h3>ใช้เกินงบ</h3><div id=\"budgetOver\"></div></section>\n              <section class=\"panel\"><h3>เหลือมากที่สุด</h3><div id=\"budgetLeft\"></div></section>\n            </div>\n            <section class=\"panel\">\n              <div class=\"filters\">\n                <input id=\"bSearch\" type=\"search\" placeholder=\"ค้นหา Location / GL / บริษัท เช่น 530090 cookies\">\n                <select id=\"bGroup\">\n                  <option value=\"line\">แยกตามรายการ Budget</option>\n                  <option value=\"gl\">รวมตาม GL Code</option>\n                  <option value=\"location\">รวมตาม Location</option>\n                  <option value=\"company\">รวมตามบริษัท</option>\n                </select>\n                <select id=\"bMonth\"><option value=\"\">ทั้งปี</option></select>\n                <select id=\"bShow\">\n                  <option value=\"\">ทุกรายการ</option>\n                  <option value=\"over\">เกินงบ</option>\n                  <option value=\"left\">ยังเหลือ</option>\n                  <option value=\"used\">มีการใช้แล้ว</option>\n                </select>\n                <span id=\"bInfo\" class=\"hint\"></span>\n              </div>\n              <p class=\"hint\">คลิกแถวเพื่อดูรายละเอียดแต่ละเดือน · คงเหลือ = งบ − ใช้จริง (Actual จากไฟล์ Budget) − คำขอในระบบที่อนุมัติ/รออนุมัติ</p>\n              <div class=\"table-wrap\"><table id=\"tblBudget\" class=\"grid\"></table></div>\n            </section>\n          </div>\n        </div>\n\n        <!-- ============ Store data ============ -->\n        <div id=\"tab-data\" class=\"tabpane\" hidden>\n          <div class=\"page-head\">\n            <div>\n              <h2>ข้อมูล Store</h2>\n              <p id=\"filesHint\" class=\"hint\">ลากไฟล์มาวางตรงไหนก็ได้ ระบบจะดูหัวตารางแล้วจัดเข้าช่องให้เอง</p>\n            </div>\n            <div class=\"panel-actions\">\n              <button id=\"btnReloadData\" class=\"btn sm ghost\" hidden>โหลดข้อมูลใหม่</button>\n              <a id=\"lnkSheet\" class=\"btn sm ghost\" target=\"_blank\" rel=\"noopener\" hidden>แก้ข้อมูลใน Google Sheet</a>\n              <button id=\"btnExportAll\" class=\"btn sm ghost\" disabled>ส่งออกไฟล์รวม (.xlsx)</button>\n              <button id=\"btnReset\" class=\"btn sm ghost\">ล้างข้อมูลในเครื่องนี้</button>\n            </div>\n          </div>\n          <section id=\"filesPanel\" class=\"panel\">\n            <div id=\"slots\" class=\"slots\"></div>\n            <input id=\"fileInput\" type=\"file\" accept=\".xls,.xlsx,.csv\" multiple hidden>\n          </section>\n          <section class=\"panel\">\n            <details class=\"settings\">\n              <summary>ตั้งค่าสูตร MIN/MAX (ขั้นสูง)</summary>\n              <div class=\"settings-grid\">\n                <label>Safety × <input type=\"number\" step=\"0.1\" data-opt=\"factorSafety\"></label>\n                <label>MIN × <input type=\"number\" step=\"0.1\" data-opt=\"factorMin\"></label>\n                <label>MAX × <input type=\"number\" step=\"0.1\" data-opt=\"factorMax\"></label>\n                <label>Lead time เริ่มต้น (วัน) <input type=\"number\" step=\"1\" data-opt=\"leadDays\"></label>\n                <label>เบิกประจำ = ใช้ ≥ <input type=\"number\" step=\"1\" data-opt=\"regularMinMonths\"> เดือน</label>\n              </div>\n              <p class=\"hint\">MIN = ตัวคูณ × (ใช้จริงเฉลี่ย/เดือน ÷ 30) × lead time · lead time ใช้ค่าจากไฟล์ MIN/MAX ถ้ามี</p>\n            </details>\n          </section>\n        </div>\n\n        <!-- Shared filters for the two item tables -->\n        <div id=\"filters\" class=\"filters\" hidden>\n          <input id=\"fSearch\" type=\"search\" placeholder=\"ค้นหารหัส / ชื่อสินค้า\">\n          <select id=\"fPc\"><option value=\"\">ทุก PC</option></select>\n          <select id=\"fShow\">\n            <option value=\"any\">แนะนำให้สั่ง</option>\n            <option value=\"all\">ทั้งหมด</option>\n            <option value=\"diff\">ผลแต่ละวิธีไม่ตรงกัน</option>\n            <option value=\"store\">Store แจ้งสั่ง</option>\n            <option value=\"actual\">ใช้จริงแนะนำสั่ง</option>\n            <option value=\"flag\">มีข้อสังเกต</option>\n          </select>\n          <select id=\"fCat\">\n            <option value=\"\">ทุกประเภท</option>\n            <option>เบิกประจำ</option><option>เบิกตามงาน</option><option>Dead stock</option><option>ไม่มีการเคลื่อนไหว</option>\n          </select>\n          <span class=\"spacer\"></span>\n          <label class=\"inline\" title=\"จำนวนที่ใส่ให้อัตโนมัติเมื่อติ๊กเลือก\">ยอดแนะนำจาก\n            <select id=\"qtySource\">\n              <option value=\"auto\">ใช้จริง (ไม่มีใช้ Store)</option>\n              <option value=\"actual\">ยอดใช้จริง</option>\n              <option value=\"store\">Store แจ้ง</option>\n              <option value=\"manual\">MIN/MAX เดิม</option>\n            </select>\n          </label>\n        </div>\n\n        <!-- ============ Step 1: pick items ============ -->\n        <div id=\"tab-compare\" class=\"tabpane\" hidden>\n          <div class=\"page-head\">\n            <div>\n              <h2>1. เลือกรายการที่จะสั่ง</h2>\n              <p class=\"hint\">ติ๊กรายการ แก้จำนวนได้ แล้วกด <b>ถัดไป</b> ที่แถบด้านล่าง</p>\n            </div>\n            <label class=\"switch\"><input type=\"checkbox\" id=\"detailToggle\"><span>แสดงแบบละเอียด (เทียบ 3 วิธี)</span></label>\n          </div>\n          <div class=\"bulk\">\n            <button class=\"btn sm\" data-bulk=\"suggested\">เลือกทุกรายการที่แนะนำ</button>\n            <button class=\"btn sm ghost\" data-bulk=\"none\">ไม่เลือกที่แสดง</button>\n            <span class=\"detail-only\"><button class=\"btn sm ghost\" data-bulk=\"actual\">ใช้จริงแนะนำ</button>\n              <button class=\"btn sm ghost\" data-bulk=\"store\">Store แจ้ง</button>\n              <button class=\"btn sm ghost\" data-bulk=\"visible\">ทั้งหมดที่แสดง</button></span>\n            <span id=\"countInfo\" class=\"hint\"></span>\n          </div>\n          <div class=\"table-wrap\"><table id=\"tblCompare\" class=\"grid\"></table></div>\n        </div>\n\n        <div id=\"tab-merged\" class=\"tabpane\" hidden>\n          <div class=\"page-head\"><div><h2>ตารางรวมทั้งหมด</h2><p class=\"hint\">ข้อมูลทุกไฟล์รวมเป็นแถวเดียวต่อรหัสสินค้า</p></div></div>\n          <div class=\"table-wrap\"><table id=\"tblMerged\" class=\"grid\"></table></div>\n        </div>\n\n        <!-- ============ Step 2: review & send ============ -->\n        <div id=\"tab-cart\" class=\"tabpane\" hidden>\n          <div class=\"page-head\">\n            <div><h2>2. ตรวจรายการ &amp; ส่งคำขอ</h2><p id=\"cartTotal\" class=\"hint\"></p></div>\n            <div class=\"panel-actions\">\n              <button id=\"btnExportCart\" class=\"btn sm ghost\">ส่งออก .xlsx</button>\n              <button id=\"btnCopyCart\" class=\"btn sm ghost\">คัดลอก</button>\n              <button id=\"btnClearCart\" class=\"btn sm ghost\">ล้างรายการ</button>\n            </div>\n          </div>\n          <ol id=\"cartStepper\" class=\"stepper\">\n            <li>ตรวจจำนวน</li><li>เลือก Budget + เดือน</li><li>ส่งให้ Admin ตรวจ</li>\n          </ol>\n          <div id=\"cartBody\"></div>\n\n          <div id=\"submitBox\" class=\"panel submit-box\">\n            <h3 id=\"submitTitle\">ส่งคำขอสั่งซื้อให้ Admin</h3>\n            <p id=\"submitHint\" class=\"hint\"></p>\n            <div id=\"submitForm\" class=\"submit-grid\">\n              <div class=\"field\">\n                <label for=\"budgetSearch\">Budget ตั้งต้น (ใช้กับรายการที่ยังไม่ได้เลือก Budget)</label>\n                <input id=\"budgetSearch\" type=\"search\" placeholder=\"ค้นหา เช่น 530090 cookies\">\n                <select id=\"budgetSel\" size=\"7\"></select>\n                <label for=\"monthSel\">ใช้ของเดือน</label>\n                <select id=\"monthSel\"></select>\n                <button id=\"btnApplyBudget\" class=\"btn sm ghost\" type=\"button\">ใช้ Budget + เดือนนี้กับทุกรายการ</button>\n                <p class=\"hint\">เปลี่ยน Budget / เดือน ของแต่ละรายการได้ในตารางด้านบน</p>\n              </div>\n              <div class=\"field\">\n                <label>สรุปงบตาม Budget ที่เลือก</label>\n                <div id=\"budgetInfo\" class=\"budget-info\"></div>\n                <label for=\"reqNote\">หมายเหตุถึง Admin</label>\n                <textarea id=\"reqNote\" rows=\"2\" placeholder=\"เช่น ต้องการด่วนภายใน…, เบื้องต้นได้ปรึกษา…แล้ว\"></textarea>\n                <button id=\"btnSubmitReq\" class=\"btn lg\">ส่งคำขอให้ Admin ตรวจ</button>\n              </div>\n            </div>\n          </div>\n\n          <div id=\"roundBox\" class=\"panel submit-box\" hidden>\n            <h3>หรือ (Admin): ส่งให้แต่ละ PC ยืนยันเอง</h3>\n            <p class=\"hint\">แยกรายการตาม PC แล้วอีเมลถึงผู้รับผิดชอบใน Master PC — PC แก้จำนวน เลือก Budget + เดือน แล้วส่งกลับมาให้อนุมัติ · ไม่ตอบใน 3 วันระบบเตือนซ้ำ</p>\n            <div class=\"inline-form\">\n              <input id=\"roundNote\" placeholder=\"หมายเหตุถึงทุก PC (ไม่บังคับ) เช่น ขอคำตอบภายในวันศุกร์\" style=\"flex:1 1 320px\">\n              <button id=\"btnRound\" class=\"btn\">ส่งให้ PC ยืนยันทางอีเมล</button>\n            </div>\n          </div>\n        </div>\n\n        <!-- ============ Step 3: track requests ============ -->\n        <div id=\"tab-requests\" class=\"tabpane\" hidden>\n          <div class=\"page-head\">\n            <div><h2>3. ติดตามคำขอ</h2><p id=\"reqInfo\" class=\"hint\"></p></div>\n            <div class=\"panel-actions\">\n              <select id=\"reqFilter\">\n                <option value=\"todo\">รอฉันดำเนินการ</option>\n                <option value=\"\">ทั้งหมด</option>\n                <option>รอ PC ยืนยัน</option>\n                <option>รอ Admin ตรวจ</option>\n                <option>รอผู้บริหารอนุมัติ</option>\n                <option>รอหัวหน้าอนุมัติเกินงบ</option>\n                <option>อนุมัติ</option>\n                <option>ออก PR/PO แล้ว</option>\n                <option>รับของแล้ว</option>\n                <option>ไม่อนุมัติ</option>\n                <option>PC ปฏิเสธ</option>\n                <option>ยกเลิก</option>\n              </select>\n              <button id=\"btnReloadReq\" class=\"btn sm ghost\">โหลดใหม่</button>\n            </div>\n          </div>\n          <div id=\"reqDash\" class=\"dash\"></div>\n          <div id=\"reqList\"></div>\n        </div>\n\n        <!-- ============ Admin ============ -->\n        <div id=\"tab-admin\" class=\"tabpane\" hidden>\n          <div class=\"page-head\"><div><h2>ตั้งค่าระบบ</h2><p class=\"hint\">สมาชิก · Budget · ผู้รับผิดชอบแต่ละ PC · การเตือนอัตโนมัติ</p></div></div>\n          <div class=\"admin-grid\">\n            <section class=\"panel\">\n              <h3>สมาชิก</h3>\n              <form id=\"memberAdd\" class=\"inline-form\">\n                <input name=\"username\" placeholder=\"ID\" required autocomplete=\"off\">\n                <input name=\"password\" type=\"password\" placeholder=\"รหัสผ่านเริ่มต้น (8+ ตัว)\" minlength=\"8\" required autocomplete=\"new-password\">\n                <input name=\"name\" placeholder=\"ชื่อ\">\n                <input name=\"email\" type=\"email\" placeholder=\"อีเมล (รับแจ้งเตือน)\">\n                <select name=\"role\"><option value=\"user\">User</option><option value=\"admin\">Admin</option></select>\n                <button class=\"btn sm\">เพิ่มสมาชิก</button>\n              </form>\n              <div class=\"table-wrap\" style=\"max-height:none\"><table id=\"tblMembers\" class=\"grid\"></table></div>\n            </section>\n            <section class=\"panel\">\n              <h3>ข้อมูล Budget</h3>\n              <p id=\"budgetStatus\" class=\"hint\"></p>\n              <button id=\"btnBudgetFile\" class=\"btn sm\">นำเข้าไฟล์ Budget (.xlsx)</button>\n              <button id=\"btnBudgetDrive\" class=\"btn sm ghost\" title=\"หาไฟล์ที่ชื่อมีคำว่า Budget STT ล่าสุดใน Google Drive\">นำเข้าจาก Google Drive</button>\n              <input id=\"budgetFile\" type=\"file\" accept=\".xlsx,.xls\" hidden>\n              <p class=\"hint\">ไฟล์ \"Budget STT 2026 - Revise-Budget\" · นำเข้าใหม่จะแทนที่ของเดิม ·\n                งบ/เดือน = Revise Budget (ถ้ามี) ไม่งั้น Budget · คงเหลือ = งบ − Actual − คำขอที่ค้างอยู่</p>\n              <h3 style=\"margin-top:16px\">เตือนอัตโนมัติ</h3>\n              <p class=\"hint\">อีเมลเตือน PC ที่ยังไม่ยืนยันเกิน 3 วัน ทุกวัน 09:00</p>\n              <button id=\"btnTrigger\" class=\"btn sm ghost\">เปิดการเตือนอัตโนมัติ</button>\n            </section>\n          </div>\n          <section class=\"panel\">\n            <h3>ตั้งค่าอีเมลขออนุมัติ</h3>\n            <p class=\"hint\">ค่าตั้งต้นตอน Admin กด \"ส่งอีเมลขออนุมัติผู้บริหาร\" และ \"ส่งแจ้งฝ่ายจัดซื้อ\" — แก้ได้อีกครั้งก่อนส่งทุกครั้ง</p>\n            <form id=\"settingsForm\" class=\"compose-grid\">\n              <label>ชื่อทีม (ต่อท้ายเรื่อง)<input name=\"team_name\" placeholder=\"ทีม Static\"></label>\n              <label>เรียน (ผู้อนุมัติ)<input name=\"approval_greeting\" placeholder=\"เช่น คุณวสุ\"></label>\n              <label>ผู้อนุมัติ — ถึง<input name=\"approval_to\" placeholder=\"อีเมล คั่นด้วย ,\"></label>\n              <label>ผู้อนุมัติ — สำเนา (CC)<input name=\"approval_cc\" placeholder=\"ผู้เกี่ยวข้อง\"></label>\n              <label>ฝ่ายจัดซื้อ — ถึง<input name=\"purchasing_to\" placeholder=\"อีเมลฝ่ายจัดซื้อ\"></label>\n              <label>ฝ่ายจัดซื้อ — สำเนา (CC)<input name=\"purchasing_cc\"></label>\n              <label class=\"wide\">ข้อความเพิ่มเติม (ไม่บังคับ)<textarea name=\"approval_intro\" rows=\"2\"></textarea></label>\n              <label class=\"wide\">ลิงก์แนบ (ไม่บังคับ)<input name=\"approval_link\" placeholder=\"https://…\"></label>\n              <label class=\"wide\">ลายเซ็นท้ายอีเมล<textarea name=\"signature\" rows=\"3\" placeholder=\"Thank you,&#10;ชื่อ ตำแหน่ง&#10;Tel.\"></textarea></label>\n              <div class=\"wide\"><button class=\"btn sm\" type=\"submit\">บันทึกการตั้งค่า</button> <span id=\"settingsStatus\" class=\"hint\"></span></div>\n            </form>\n          </section>\n          <section class=\"panel\">\n            <h3>Master PC — ผู้รับผิดชอบยืนยันรายการ และหัวหน้าอนุมัติเกินงบ</h3>\n            <p class=\"hint\">แถวที่ไฮไลต์ = ยังไม่มีอีเมลผู้รับผิดชอบ (สร้างคำขอได้ แต่ยังส่งอีเมลไม่ได้)</p>\n            <div class=\"table-wrap\" style=\"max-height:none\"><table id=\"tblMasterPc\" class=\"grid\"></table></div>\n          </section>\n        </div>\n\n        <!-- ============ AI ============ -->\n        <div id=\"tab-ai\" class=\"tabpane\" hidden>\n          <div class=\"page-head\"><div><h2>ผู้ช่วย AI</h2><p class=\"hint\">ช่วยสรุปและร่างข้อความจากตัวเลขที่ระบบคำนวณแล้ว — ไม่เปลี่ยนตัวเลขหรืออนุมัติแทนคน</p></div></div>\n          <section class=\"panel ai\">\n            <div class=\"ai-key\">\n              <input id=\"aiKey\" type=\"password\" placeholder=\"Anthropic API key (เก็บในเบราว์เซอร์นี้เท่านั้น)\" autocomplete=\"off\">\n              <but