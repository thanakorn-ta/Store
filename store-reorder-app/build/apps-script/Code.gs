iv class=\"panel-head\">\n        <h2>1. ข้อมูล Store</h2>\n        <p id=\"filesHint\" class=\"hint\">ลากไฟล์มาวางตรงไหนก็ได้ ระบบจะดูหัวตารางแล้วจัดเข้าช่องให้เอง · ไฟล์ประมวลผลในเครื่องนี้เท่านั้น ไม่ถูกอัปโหลดไปที่ไหน</p>\n        <div class=\"panel-actions\">\n          <button id=\"btnReloadData\" class=\"btn sm ghost\" hidden>โหลดข้อมูลใหม่</button>\n          <a id=\"lnkSheet\" class=\"btn sm ghost\" target=\"_blank\" rel=\"noopener\" hidden>แก้ข้อมูลใน Google Sheet</a>\n        </div>\n      </div>\n      <div id=\"slots\" class=\"slots\"></div>\n      <input id=\"fileInput\" type=\"file\" accept=\".xls,.xlsx,.csv\" multiple hidden>\n    </section>\n\n    <!-- 2. Summary -->\n    <section id=\"summary\" class=\"panel\" hidden>\n      <div class=\"panel-head\">\n        <h2>2. ภาพรวม</h2>\n        <details class=\"settings\">\n          <summary>ตั้งค่าสูตร MIN/MAX</summary>\n          <div class=\"settings-grid\">\n            <label>Safety × <input type=\"number\" step=\"0.1\" data-opt=\"factorSafety\"></label>\n            <label>MIN × <input type=\"number\" step=\"0.1\" data-opt=\"factorMin\"></label>\n            <label>MAX × <input type=\"number\" step=\"0.1\" data-opt=\"factorMax\"></label>\n            <label>Lead time เริ่มต้น (วัน) <input type=\"number\" step=\"1\" data-opt=\"leadDays\"></label>\n            <label>เบิกประจำ = ใช้ ≥ <input type=\"number\" step=\"1\" data-opt=\"regularMinMonths\"> เดือน</label>\n          </div>\n          <p class=\"hint\">MIN = ตัวคูณ × (ใช้จริงเฉลี่ย/เดือน ÷ 30) × lead time · lead time ใช้ค่าจากไฟล์ MIN/MAX ถ้ามี</p>\n        </details>\n      </div>\n      <div id=\"cards\" class=\"cards\"></div>\n    </section>\n\n    <!-- 3. Tables -->\n    <section id=\"work\" class=\"panel\" hidden>\n      <nav class=\"tabs\" role=\"tablist\">\n        <button class=\"tab active\" data-tab=\"compare\">เทียบยอดสั่งซื้อ</button>\n        <button class=\"tab\" data-tab=\"merged\">ตารางรวมทั้งหมด</button>\n        <button class=\"tab\" data-tab=\"cart\">รายการที่เลือกสั่ง <span id=\"cartBadge\" class=\"badge\">0</span></button>\n        <button class=\"tab\" data-tab=\"requests\" id=\"tabRequests\" hidden>คำขอสั่งซื้อ <span id=\"reqBadge\" class=\"badge\" hidden>0</span></button>\n        <button class=\"tab\" data-tab=\"admin\" id=\"tabAdmin\" hidden>Admin</button>\n        <button class=\"tab\" data-tab=\"ai\">ผู้ช่วย AI</button>\n      </nav>\n\n      <div id=\"filters\" class=\"filters\">\n        <input id=\"fSearch\" type=\"search\" placeholder=\"ค้นหารหัส / ชื่อสินค้า\">\n        <select id=\"fPc\"><option value=\"\">ทุก PC</option></select>\n        <select id=\"fCat\">\n          <option value=\"\">ทุกประเภท</option>\n          <option>เบิกประจำ</option><option>เบิกตามงาน</option><option>Dead stock</option><option>ไม่มีการเคลื่อนไหว</option>\n        </select>\n        <select id=\"fShow\">\n          <option value=\"any\">มีวิธีใดวิธีหนึ่งแนะนำให้สั่ง</option>\n          <option value=\"diff\">ผลแต่ละวิธีไม่ตรงกัน</option>\n          <option value=\"store\">Store แจ้งสั่ง</option>\n          <option value=\"actual\">ใช้จริงแนะนำสั่ง</option>\n          <option value=\"flag\">มีข้อสังเกต</option>\n          <option value=\"all\">ทั้งหมด</option>\n        </select>\n        <span class=\"spacer\"></span>\n        <label class=\"inline\">จำนวนตั้งต้นเมื่อเลือก\n          <select id=\"qtySource\">\n            <option value=\"auto\">ใช้จริง (ถ้าไม่มีใช้ของ Store)</option>\n            <option value=\"actual\">ตามยอดใช้จริง</option>\n            <option value=\"store\">ตาม Store แจ้ง</option>\n            <option value=\"manual\">ตาม MIN/MAX เดิม</option>\n          </select>\n        </label>\n      </div>\n\n      <div id=\"tab-compare\" class=\"tabpane\">\n        <div class=\"bulk\">\n          <button class=\"btn sm\" data-bulk=\"actual\">เลือกทุกรายการที่ใช้จริงแนะนำ</button>\n          <button class=\"btn sm\" data-bulk=\"store\">เลือกทุกรายการที่ Store แจ้ง</button>\n          <button class=\"btn sm\" data-bulk=\"visible\">เลือกทั้งหมดที่แสดง</button>\n          <button class=\"btn sm ghost\" data-bulk=\"none\">ไม่เลือกที่แสดง</button>\n          <span id=\"countInfo\" class=\"hint\"></span>\n        </div>\n        <div class=\"table-wrap\"><table id=\"tblCompare\" class=\"grid\"></table></div>\n      </div>\n\n      <div id=\"tab-merged\" class=\"tabpane\" hidden>\n        <div class=\"table-wrap\"><table id=\"tblMerged\" class=\"grid\"></table></div>\n      </div>\n\n      <div id=\"tab-cart\" class=\"tabpane\" hidden>\n        <div class=\"bulk\">\n          <button id=\"btnExportCart\" class=\"btn\">ส่งออกใบขอซื้อ (.xlsx)</button>\n          <button id=\"btnCopyCart\" class=\"btn ghost\">คัดลอกเป็นข้อความ</button>\n          <button id=\"btnClearCart\" class=\"btn ghost\">ล้างรายการ</button>\n          <span id=\"cartTotal\" class=\"hint\"></span>\n        </div>\n        <div id=\"cartBody\"></div>\n\n        <div id=\"roundBox\" class=\"submit-box\" hidden>\n          <h3>Admin: ส่งให้แต่ละ PC ยืนยัน (workflow ขั้นที่ 5)</h3>\n          <p class=\"hint\">แยกรายการตาม PC แล้วส่งอีเมล (AI ช่วยร่าง ถ้าตั้ง API key) ถึงผู้รับผิดชอบใน Master PC —\n            PC ยืนยัน/แก้จำนวน + เลือก Budget และเดือน → กลับมาให้ Admin ตรวจงบ → PR/PO · ไม่ตอบใน 3 วันระบบเตือนซ้ำ</p>\n          <div class=\"inline-form\">\n            <input id=\"roundNote\" placeholder=\"หมายเหตุถึงทุก PC (ไม่บังคับ) เช่น ขอคำตอบภายในวันศุกร์\" style=\"flex:1 1 320px\">\n            <button id=\"btnRound\" class=\"btn\">ส่งให้ PC ยืนยันทางอีเมล</button>\n          </div>\n        </div>\n\n        <div id=\"submitBox\" class=\"submit-box\">\n          <h3>ส่งคำขอสั่งซื้อให้ Admin</h3>\n          <p id=\"submitHint\" class=\"hint\"></p>\n          <div id=\"submitForm\" class=\"submit-grid\">\n            <div class=\"field\">\n              <label for=\"budgetSearch\">1. เลือก Budget</label>\n              <input id=\"budgetSearch\" type=\"search\" placeholder=\"ค้นหา Location / GL / บริษัท เช่น 530090, Metro, Cookies\">\n              <select id=\"budgetSel\" size=\"7\"></select>\n            </div>\n            <div class=\"field\">\n              <label for=\"monthSel\">2. ใช้ของเดือน</label>\n              <select id=\"monthSel\"></select>\n              <div id=\"budgetInfo\" class=\"budget-info\"></div>\n              <label for=\"reqNote\">หมายเหตุถึง Admin</label>\n              <textarea id=\"reqNote\" rows=\"3\" placeholder=\"เช่น ใช้งานโปรเจกต์…, ต้องการด่วนภายใน…\"></textarea>\n              <button id=\"btnSubmitReq\" class=\"btn\">ส่งคำขอให้ Admin</button>\n            </div>\n          </div>\n        </div>\n      </div>\n\n      <div id=\"tab-requests\" class=\"tabpane\" hidden>\n        <div class=\"bulk\">\n          <select id=\"reqFilter\">\n            <option value=\"todo\">รอฉันดำเนินการ</option>\n            <option value=\"\">ทั้งหมด</option>\n            <option>รอ PC ยืนยัน</option>\n            <option>รออนุมัติ</option>\n            <option>รอหัวหน้าอนุมัติเกินงบ</option>\n            <option>อนุมัติ</option>\n            <option>ออก PR/PO แล้ว</option>\n            <option>รับของแล้ว</option>\n            <option>ไม่อนุมัติ</option>\n            <option>PC ปฏิเสธ</option>\n            <option>ยกเลิก</option>\n          </select>\n          <button id=\"btnReloadReq\" class=\"btn sm ghost\">โหลดใหม่</button>\n          <span id=\"reqInfo\" class=\"hint\"></span>\n        </div>\n        <div id=\"reqDash\" class=\"dash\"></div>\n        <div id=\"reqList\"></div>\n      </div>\n\n      <div id=\"tab-admin\" class=\"tabpane\" hidden>\n        <div class=\"admin-grid\">\n          <section>\n            <h3>สมาชิก</h3>\n            <form id=\"memberAdd\" class=\"inline-form\">\n              <input name=\"username\" placeholder=\"ID\" required autocomplete=\"off\">\n              <input name=\"password\" type=\"password\" placeholder=\"รหัสผ่านเริ่มต้น (8+ ตัว)\" minlength=\"8\" required autocomplete=\"new-password\">\n              <input name=\"name\" placeholder=\"ชื่อ\">\n              <input name=\"email\" type=\"email\" placeholder=\"อีเมล (รับแจ้งเตือน)\">\n              <select name=\"role\"><option value=\"user\">User</option><option value=\"admin\">Admin</option></select>\n              <button class=\"btn sm\">เพิ่มสมาชิก</button>\n            </form>\n            <div class=\"table-wrap\" style=\"max-height:none\"><table id=\"tblMembers\" class=\"grid\"></table></div>\n          </section>\n          <section>\n            <h3>ข้อมูล Budget</h3>\n            <p id=\"budgetStatus\" class=\"hint\"></p>\n            <button id=\"btnBudgetFile\" class=\"btn sm\">นำเข้าไฟล์ Budget (.xlsx)</button>\n            <input id=\"budgetFile\" type=\"file\" accept=\".xlsx,.xls\" hidden>\n            <p class=\"hint\">ไฟล์ \"Budget STT 2026 - Revise-Budget\" · นำเข้าใหม่จะแทนที่ของเดิมทั้งหมด ·\n              งบต่อเดือน = Revise Budget (ถ้ามี) ไม่งั้นใช้ Budget · คงเหลือ = งบ − Actual − คำขอที่รออนุมัติ/อนุมัติแล้ว</p>\n            <h3 style=\"margin-top:16px\">เตือนอัตโนมัติ</h3>\n            <p class=\"hint\">ส่งอีเมลเตือน PC ที่ยังไม่ยืนยันเกิน 3 วัน ทุกวัน 09:00</p>\n            <button id=\"btnTrigger\" class=\"btn sm ghost\">เปิดการเตือนอัตโนมัติ</button>\n          </section>\n        </div>\n        <section style=\"margin-top:18px\">\n          <h3>Master PC — ผู้รับผิดชอบยืนยันรายการ และหัวหน้าอนุมัติเกินงบ</h3>\n          <p class=\"hint\">แถวที่ไฮไลต์ = ยังไม่มีอีเมลผู้รับผิดชอบ (ระบบจะสร้างคำขอให้แต่ยังส่งอีเมลไม่ได้) · แก้ในชีต master_pc ได้เช่นกัน</p>\n          <div class=\"table-wrap\" style=\"max-height:none\"><table id=\"tblMasterPc\" class=\"grid\"></table></div>\n        </section>\n      </div>\n\n      <div id=\"tab-ai\" class=\"tabpane\" hidden>\n        <div class=\"ai\">\n          <p class=\"hint\">ผู้ช่วย AI (Claude) ช่วยสรุปและร่างข้อความจากตัวเลขที่ระบบคำนวณแล้ว — ไม่เปลี่ยนตัวเลขหรืออนุมัติแทนคน\n            ข้อมูลที่ส่งไปคือสรุปรายการที่มีข้อสังเกตและรายการที่เลือกสั่ง (ไม่ใช่ไฟล์ทั้งไฟล์)</p>\n          <div class=\"ai-key\">\n            <input id=\"aiKey\" type=\"password\" placeholder=\"Anthropic API key (เก็บในเบราว์เซอร์นี้เท่านั้น)\" autocomplete=\"off\">\n            <button id=\"aiKeyClear\" class=\"btn sm ghost\">ลบ key</button>\n          </div>\n          <div class=\"ai-presets\">\n            <button class=\"btn sm\" data-ask=\"สรุปภาพรวมการสั่งซื้อรอบนี้ เทียบ 3 วิธี และบอกว่าควรเชื่อวิธีไหนสำหรับรายการแบบไหน\">สรุปรอบนี้</button>\n            <button class=\"btn sm\" data-ask=\"รายการไหนที่ควรตรวจสอบก่อนสั่ง เพราะผลแต่ละวิธีขัดกันหรือมีข้อสังเกต เรียงตามมูลค่า\">รายการที่ต้องระวัง</button>\n            <button class=\"btn sm\" data-ask=\"ร่างอีเมลแจ้งแต่ละ PC ให้ยืนยันรายการที่เลือกสั่ง ใช้ตัวเลขตามที่ให้มาเท่านั้น\">ร่างอีเมลยืนยัน</button>\n            <button class=\"btn sm\" data-ask=\"วิเคราะห์ Dead stock และรายการที่ Avg กรอกเองสูงเกินจริง ควรปรับ MIN/MAX อย่างไร\">Dead stock / ปรับ MIN-MAX</button>\n          </div>\n          <textarea id=\"aiQ\" rows=\"3\" placeholder=\"ถามเกี่ยวกับข้อมูลรอบนี้…\"></textarea>\n          <div><button id=\"aiAsk\" class=\"btn\">ถาม AI</button> <span id=\"aiStatus\" class=\"hint\"></span></div>\n          <div id=\"aiOut\" class=\"ai-out\"></div>\n        </div>\n      </div>\n    </section>\n  </main>\n\n  <div id=\"toast\" class=\"toast\" hidden></div>\n  <!-- GENERATED by tools/build-appsscript.ps1 from web/ - do not edit; edit web/ and rebuild -->\n<script>\n/**\n * parsers.js\n * Reads the 4 Store export formats (as SheetJS row arrays) into plain records.\n * Column positions are found from each file's header row, not hard-coded,\n * so a shifted column in a future export still parses.\n *\n *   minmax  : MIN_MAX_Calculated.xlsx          (hand-entered Avg/MIN/MAX)\n *   usage   : รวมการใช้ของ.xlsx / การใช้งานเดือน*.xls (monthly withdrawals)\n *   balance : ยอดคงเหลือสินค้า.xls               (stock on hand)\n *   reorder : รายงานสินค้าถ